# Copy to .env (or run `vercel env pull`) and fill in values. Never commit real values.

# Postgres connection string (Neon on Vercel provides DATABASE_URL automatically)
DATABASE_URL=

# Long random string used to sign login tokens (openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma separated browser origins allowed to call the API
CORS_ORIGINS=
FRONTEND_URL=

# Optional: Chapa test secret key enables paid checkout
CHAPA_SECRET_KEY=

# Optional: AI Gateway key for local runs (deployments use the Vercel OIDC token)
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash

# Optional: SMTP settings; without them emails are only logged
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Demo account password used by the seed script
DEMO_PASSWORD=
